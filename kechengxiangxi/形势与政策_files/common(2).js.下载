//tab切换
function initTab(parent, changeBack, x) {
    var _index = x || 1;
    $(parent).find('.tab-head .tab-t').removeClass('current');
    $(parent).find('.tab-head .tab-t').eq(_index - 1).addClass('current');
    $(parent).find('.tab-list').hide();
    $(parent).find('.tab-list').eq(_index - 1).show();
	$(parent).off('click', '.tab-head .tab-t');
    $(parent).on('click', '.tab-head .tab-t', function () {
        if($(this).hasClass("current")){
            return;
        }
        $(this).siblings().removeClass('current');
        $(this).addClass('current');
        $(parent).find('.tab-list').hide();
        var index = $(this).index();
        $(parent).find('.tab-list').eq(index).show();
        if (changeBack) {
            changeBack();
        }
    })

}

// 点击弹框区域外，关闭弹框
function clickBesideClose(triggerObj, popObj) {
    $(document).on("click", function (event) {
        if (triggerObj[0] && !triggerObj[0].contains(event.target)) {
            popObj.slideUp();
        }
    })
}

// 设置main的最小高度
function setMainHeight(options) {
    var defaults = {
        target: $(".main"),
        height: 112 // 112为main上下的margin的高度
    };
    var sets = $.extend(defaults, options || {});
    var windowH = $(window).height();
    var height = windowH - sets.height;
    sets.target.css("min-height", height);

    // 窗口resize,内容高度优化
    $(window).resize(function () {
        setTimeout(function () {
            windowH = $(window).height();
            height = windowH - sets.height; // 112为main上下的margin的高度
            sets.target.css("min-height", height);
        }, 50);
    });
}

// 设置x 的最大高度
function setHeight(options) {
    var defaults = {
        type: 'height',
        target: $(".main"),
        height: 112 // 112为main上下的margin的高度
    };
    var sets = $.extend(defaults, options || {});
    var windowH = $(window).height();
    var height = windowH - sets.height;
    sets.target.css(sets.type, height);

    // 窗口resize,内容高度优化
    $(window).resize(function () {
        setTimeout(function () {
            windowH = $(window).height();
            height = windowH - sets.height; // 112为main上下的margin的高度
            sets.target.css(sets.type, height);
            sets.target.getNiceScroll().resize()
        }, 50);
    });
}

//查看大图--班级活动列表，创建选人，抢答，评分等活动弹窗时，添加图片后，点击图片走这个创建图片查看器方法--还有拍照签到的详情页也走这个方法
function initLookBigImg(box,fromActiveList) {
    addBtnWrap();
    $('body').on('click', box + ' img', function () {
        var index = 0;
        if(fromActiveList==1){
            index =  $(this).parent("li").index();
        }else{
            index =  $(this).index();
        }
        $(box).viewer({
            navbar: false,
            url: 'data-orignal',
            title: false,
            toolbar: false,
        });
        viewer = $(this).parents(box).data('viewer');
        viewer.index = index;
        viewer.show();
        // $('.viewBtnWrap').fadeIn();
        $('.viewBtnWrap').fullFadeIn();
        if(fromActiveList==1){
            $(".viewer-container").css("background-color","rgba(53,61,72,1)");
            setTimeout(function(){
                $(".popDiv").css("transform","unset")
            },300)
        }
        //设置当前是第几张图片，即图片下标
        $('.viewBtnWrap').find("#viewPageNum").find("#imgIndex").text(Number(index)+1);
        //设置总共有多少图片，即图片总数
        let imgNumber = $(this).parent(".top-img-list").find("img").length;
        if(!imgNumber || imgNumber == 0){
            //这里是创建选人活动时添加图片，然后点击查看，获取图片总数
            imgNumber = $(this).parents(".img-list").find("i.icon-del-img").length;
        }
        if(!imgNumber || imgNumber == 0){
            //这里是创建主题讨论时添加图片，然后点击查看，获取图片总数
            imgNumber = $(this).parents(".img-list").find("i.icon-del-img").length;
        }
        if(!imgNumber || imgNumber == 0){
            //都打开图片查看器查看图片了，默认有一张图片
            imgNumber = 1;
        }
        $('.viewBtnWrap').find("#viewPageNum").find("#imgNumber").text(Number(imgNumber));
        unactiveViewBtn();
    })
    //    上一张
    $("#viewPrev").on("click", function () {
        viewer.prev();
        unactiveViewBtn();
        //设置当前是多少页
        let content = $('.viewBtnWrap').find("#viewPageNum").find("#imgIndex").text();
        //如果当前页大于等于2，则点击上一张时当前页码数减1
        if(Number(content) >= 2){
            //恢复图片放大比例
            proportion = 100;
            $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
            //页码数字减1
            $('.viewBtnWrap').find("#viewPageNum").find("#imgIndex").text(Number(content) - 1);
        }
    })
    //    下一张
    $("#viewNext").on("click", function () {
        viewer.next();
        unactiveViewBtn();
        //设置当前是多少页
        let content = $('.viewBtnWrap').find("#viewPageNum").find("#imgIndex").text();
        let imgNumber = $(".viewBtnWrap").find("#viewPageNum").find("#imgNumber").text();
        //如果当前页小于总页数，则点击下一张时当前页码数加1
        if(Number(content) < Number(imgNumber)){
            //恢复图片放大比例
            proportion = 100;
            $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
            //页码数字加1
            $('.viewBtnWrap').find("#viewPageNum").find("#imgIndex").text(Number(content) + 1);
        }
    })
    //    放大
    $("#viewZoomIn").on("click", function () {
        viewer.zoom(0.1);
        proportion = proportion + 10;
        $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
    })
    // 缩小
    $("#viewZoomOut").on("click", function () {
        viewer.zoom(-0.1);
        proportion = proportion - 10;
        $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
    })
    //    旋转
    $("#viewFlip").on("click", function () {
        viewer.rotate(-90);
    });
    //    关闭
    $("body").on("click",".viewer-container",function(){
        viewer.destroy();
        $('.viewBtnWrap').fullFadeOut();
        $(".popDiv").css("transform","translate(-50%, -50%)");
        proportion = 100;
        $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
        $('body').removeClass('viewer-open');
    });
    $("#viewClose").on("click", function () {
        viewer.destroy();
        $('.viewBtnWrap').fullFadeOut();
        $(".popDiv").css("transform","translate(-50%, -50%)");
        proportion = 100;
        $('.viewBtnWrap').find(".proportion_div").find("#proportion").text(proportion+"%");
        $('body').removeClass('viewer-open');
    })
}

