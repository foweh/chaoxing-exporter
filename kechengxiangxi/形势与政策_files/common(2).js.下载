    $.fn.autoHeightTextarea = function(options) {
        var defaults={
            maxHeight:96,//文本框是否自动撑高,默认:null,不自动撑高;如果自动撑高必须输入数值,该值作为文本框自动撑高的最大高度
            minHeight:38 //默认最小高度，也就是文本框最初的高度，当内容高度小于这个高度的时候，文本以这个高度显示
        };
        var opts = $.extend({},defaults,options);
        return $(this).each(function() {
            $(this).unbind("input propertychange focus");
            $(this).bind("input propertychange focus",function(){
                var height,style=this.style;
                this.style.height =  opts.minHeight + 'px'
                style.overflowY = 'hidden';
                if (this.scrollHeight > opts.minHeight) {
                    if (opts.maxHeight && this.scrollHeight > opts.maxHeight) {
                        height = opts.maxHeight;
                        style.overflowY = 'scroll';
                        if ($(this).hasClass("hasPic")){
                            style.padding= '8px 30px 8px 14px'
                        }
                        if ($(this).hasClass("noScroll")){//网页链接的不要滚动条
                            style.overflowY = 'hidden';
                        }
                    }
                    else {
                        height = this.scrollHeight;
                        style.overflowY = 'hidden';
                        if ($(this).hasClass("hasPic")){
                            style.padding= '8px 50px 8px 14px'
                        }
                    }
                    style.height = height  + 'px';
                }
            });
        });

    };
})(jQuery);
