//图片裁剪通用方法

function cropImgFun(elem) {
    var imgs,imgDivArr;
    if (elem.length == 0) {
        return
    }
    if (elem instanceof jQuery) {
        imgs = elem.find('.js-crop-img img');
        imgDivArr = elem.find('.js-crop-img');
    } else if (typeof (elem) == 'string') {
        imgs = $(elem).find('.js-crop-img img');
        imgDivArr = $(elem).find('.js-crop-img');
    }
    if (imgs.length == 0) {
        return
    }
    /*兼容切换分类或者分页时，有些数据中没有img但仍保留了之前的裁剪数据情况*/
    imgDivArr.each(function (){
        if ($(this).find('img').length == 0) {
            $(this).find('.jqthumb').remove();
            return;
        }
    })
    imgs.each(function () {
        var _class = 'jqthumb '; // 默认class 兼容之前的情况
        var customClass = $(this).attr("data-className") || '';  //用户自定义的class
        _class += customClass;
        if (!!$(this).attr("data-src") && !!!$(this).attr("src")) {
            $(this).attr("src", $(this).attr("data-src"));
        }
        if($(this).siblings(".jqthumb").length>0){
            var src = $(this).attr("data-src") || $(this).attr("src");
            $(this).siblings(".jqthumb").find("div").css("background-image","url("+src+")")
            return
        }
        if ($(this).is(':visible') && $(this).attr("src")) {
            var image = new Image();
            var $this = $(this);
            image.src = $(this).attr("src");
            image.onload = function () {
                $this.jqthumb({
                    classname: _class,
                    width: '100%',
                    height: '100%',
                    before: function (img) {
                        var imgUrl = $(img).attr('src');
                        var newUrl = imgUrl.replace(/\\/g, "/");
                        $(img).attr('src', newUrl);
                    },
                    done: function (div) {
                        if ($(div).next().length > 0) {
                            $(div).next().css("display", "none");
                        }
                    }
                });
            }
        }
    });
}
